{% comment %}
  BundleGuard Shopper Assistant — Zipchat-style storefront widget
  Enable via Theme Editor → App embeds
{% endcomment %}

<div id="bundleguard-shopper-root" data-proxy-url="/apps/bundleguard/chat"></div>

<style>
  #bundleguard-shopper-root {
    isolation: isolate;
    position: relative;
  }

  #bundleguard-shopper-root, #bundleguard-shopper-root * {
    box-sizing: border-box;
  }

  #bundleguard-shopper-root {
    /* Dark-glass / metallic palette to match a premium AI-concierge look:
       near-black glass panel, silver/white accents. Stock-status keeps its
       own green so "in stock" stays an unambiguous, separate signal. */
    --bg-black: #0a0a0c;
    --bg-ink: #f4f5f7;
    --bg-muted: rgba(244, 245, 247, 0.62);
    --bg-line: rgba(255, 255, 255, 0.14);
    --bg-silver: #c8ccd2;
    --bg-silver-bright: #eef0f3;
    --bg-radius: 26px;
    --success-bg: rgba(43, 213, 102, 0.14);
    --success-text: #38a862;
    font-family: Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
  }

  #bundleguard-shopper-root button,
  #bundleguard-shopper-root input {
    font: inherit;
  }

  @keyframes bg-launcher-float {
    0%, 100% { transform: translateY(0); }
    50% { transform: translateY(-3px); }
  }

  @keyframes bg-pulse-ring {
    0%, 100% { transform: scale(0.96); opacity: 0.3; }
    50% { transform: scale(1.1); opacity: 0; }
  }

  @keyframes bg-msg-in {
    from { opacity: 0; transform: translateY(8px); }
    to { opacity: 1; transform: translateY(0); }
  }

  @keyframes bg-dot-bounce {
    0%, 80%, 100% { transform: translateY(0); opacity: 0.45; }
    40% { transform: translateY(-4px); opacity: 1; }
  }

  @keyframes bg-spin {
    to { transform: rotate(360deg); }
  }

  .bg-shopper-launcher-wrap {
    position: fixed;
    right: 24px;
    bottom: 24px;
    z-index: 2147483000;
  }

  .bg-shopper-launcher {
    position: relative;
    width: 64px;
    height: 64px;
    border-radius: 22px;
    border: 1px solid rgba(255, 255, 255, 0.16);
    background:
      radial-gradient(circle at 30% 22%, rgba(255, 255, 255, 0.2), transparent 38%),
      linear-gradient(150deg, #1c1c1f, var(--bg-black));
    color: #fff;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    box-shadow: 0 18px 42px rgba(0, 0, 0, 0.45), inset 0 1px rgba(255, 255, 255, 0.14);
    animation: bg-launcher-float 2.8s infinite ease-in-out;
    transition: transform 0.15s ease;
  }

  .bg-shopper-launcher:active {
    transform: scale(0.94);
  }

  .bg-shopper-launcher:after {
    content: "";
    position: absolute;
    inset: -6px;
    border: 1px solid rgba(255, 255, 255, 0.28);
    border-radius: 26px;
    animation: bg-pulse-ring 2.7s infinite;
    pointer-events: none;
  }

  .bg-shopper-launcher-wrap.is-open .bg-shopper-launcher {
    animation: none;
  }

  .bg-shopper-launcher-wrap.is-open .bg-shopper-launcher:after {
    display: none;
  }

  .bg-shopper-launcher-icons {
    position: relative;
    width: 26px;
    height: 26px;
  }

  .bg-shopper-launcher svg {
    width: 26px;
    height: 26px;
    position: absolute;
    top: 0;
    left: 0;
    transition: opacity 0.2s ease, transform 0.2s ease;
  }

  .bg-launcher-icon--close {
    opacity: 0;
    transform: rotate(-90deg) scale(0.7);
  }

  .bg-shopper-launcher-wrap.is-open .bg-launcher-icon--chat {
    opacity: 0;
    transform: rotate(90deg) scale(0.7);
  }

  .bg-shopper-launcher-wrap.is-open .bg-launcher-icon--close {
    opacity: 1;
    transform: rotate(0deg) scale(1);
  }

  .bg-shopper-panel {
    position: fixed;
    right: 24px;
    bottom: 100px;
    width: min(390px, calc(100vw - 32px));
    height: min(650px, calc(100svh - 124px));
    border: 1px solid var(--bg-line);
    border-radius: var(--bg-radius);
    color: var(--bg-ink);
    background:
      radial-gradient(circle at 16% 4%, rgba(255, 255, 255, 0.12), transparent 30%),
      radial-gradient(circle at 92% 16%, rgba(200, 204, 210, 0.12), transparent 34%),
      linear-gradient(160deg, #101012f0, #08080aeb);
    box-shadow: 0 28px 80px rgba(0, 0, 0, 0.5), inset 0 1px rgba(255, 255, 255, 0.12);
    backdrop-filter: blur(22px);
    -webkit-backdrop-filter: blur(22px);
    display: none;
    flex-direction: column;
    overflow: hidden;
    z-index: 2147483000;
    transform-origin: bottom right;
    opacity: 0;
    transform: translateY(18px) scale(0.97);
    transition: opacity 0.22s ease, transform 0.26s cubic-bezier(0.22, 1, 0.36, 1);
  }

  .bg-shopper-panel.open {
    display: flex;
    opacity: 1;
    transform: translateY(0) scale(1);
  }

  .bg-shopper-panel:before {
    content: "";
    position: absolute;
    inset: 0;
    pointer-events: none;
    background-image: linear-gradient(rgba(255, 255, 255, 0.04) 1px, transparent 1px);
    background-size: 100% 12px;
    -webkit-mask-image: linear-gradient(to bottom, rgba(0, 0, 0, 0.4), transparent 55%);
    mask-image: linear-gradient(to bottom, rgba(0, 0, 0, 0.4), transparent 55%);
  }

  .bg-shopper-header {
    position: relative;
    z-index: 1;
    padding: 18px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
  }

  .bg-shopper-header-main {
    display: flex;
    align-items: center;
    gap: 14px;
    min-width: 0;
  }

  .bg-shopper-logo {
    position: relative;
    width: 48px;
    height: 48px;
    border-radius: 15px;
    border: 1px solid rgba(255, 255, 255, 0.18);
    background:
      radial-gradient(circle at 30% 20%, rgba(255, 255, 255, 0.2), transparent 42%),
      linear-gradient(150deg, #1d1d20, var(--bg-black));
    box-shadow: inset 0 1px rgba(255, 255, 255, 0.18), 0 8px 22px rgba(0, 0, 0, 0.4);
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    color: var(--bg-silver-bright);
  }

  .bg-shopper-logo svg {
    width: 22px;
    height: 22px;
  }

  .bg-shopper-eyebrow {
    margin: 0;
    color: var(--bg-silver);
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.13em;
    text-transform: uppercase;
  }

  .bg-shopper-header strong {
    display: block;
    margin-top: 2px;
    color: #fff;
    font-size: 17px;
    line-height: 1.15;
    letter-spacing: -0.02em;
    font-weight: 700;
  }

  .bg-shopper-status {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    margin-top: 6px;
    color: var(--bg-muted);
    font-size: 12px;
  }

  .bg-shopper-status i {
    width: 7px;
    height: 7px;
    border-radius: 999px;
    background: var(--bg-silver-bright);
    box-shadow: 0 0 0 5px rgba(255, 255, 255, 0.1);
    font-style: normal;
  }

  .bg-shopper-close {
    background: rgba(255, 255, 255, 0.08);
    border: 1px solid rgba(255, 255, 255, 0.1);
    color: rgba(255, 255, 255, 0.85);
    cursor: pointer;
    width: 34px;
    height: 34px;
    border-radius: 999px;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    transition: border-color 0.16s ease, background 0.16s ease, transform 0.16s ease;
  }

  .bg-shopper-close:hover {
    border-color: rgba(255, 255, 255, 0.4);
    background: rgba(255, 255, 255, 0.16);
    transform: translateY(-1px);
  }

  .bg-shopper-close svg {
    width: 18px;
    height: 18px;
  }

  .bg-shopper-messages {
    position: relative;
    z-index: 1;
    flex: 1;
    min-height: 0;
    overflow-y: auto;
    padding: 18px;
    scroll-behavior: smooth;
    scrollbar-width: thin;
    scrollbar-color: rgba(255, 255, 255, 0.32) transparent;
  }

  .bg-msg {
    max-width: 84%;
    margin-bottom: 12px;
    padding: 12px 14px;
    font-size: 14px;
    line-height: 1.5;
    letter-spacing: -0.01em;
    white-space: pre-wrap;
    animation: bg-msg-in 0.25s ease-out;
  }

  .bg-msg.assistant {
    border: 1px solid rgba(255, 255, 255, 0.09);
    border-radius: 18px 18px 18px 7px;
    color: rgba(255, 255, 255, 0.9);
    background: rgba(255, 255, 255, 0.08);
    box-shadow: inset 0 1px rgba(255, 255, 255, 0.08);
  }

  .bg-msg.user {
    margin-left: auto;
    border: 1px solid rgba(255, 255, 255, 0.3);
    border-radius: 18px 18px 7px;
    color: #0c0c0e;
    background: linear-gradient(135deg, #fff, var(--bg-silver));
    box-shadow: 0 10px 24px rgba(0, 0, 0, 0.35);
  }

  .bg-msg.user img {
    display: block;
    max-width: 180px;
    border-radius: 10px;
    margin-top: 6px;
  }

  .bg-typing {
    display: inline-flex;
    gap: 5px;
    align-items: center;
    padding: 4px 0;
    min-width: 58px;
  }

  .bg-typing span {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.85);
    animation: bg-dot-bounce 1s infinite ease-in-out;
  }

  .bg-typing span:nth-child(2) { animation-delay: 0.12s; }
  .bg-typing span:nth-child(3) { animation-delay: 0.24s; }

  .bg-reco-list {
    display: flex;
    flex-direction: column;
    gap: 10px;
    margin: 4px 0 12px;
    max-width: 100%;
  }

  .bg-product-card {
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 16px;
    padding: 10px;
    background: rgba(255, 255, 255, 0.06);
    display: grid;
    grid-template-columns: 72px 1fr auto;
    gap: 12px;
    align-items: center;
    animation: bg-msg-in 0.3s ease-out;
    transition: border-color 0.15s ease, background 0.15s ease;
  }

  .bg-product-card:hover {
    border-color: rgba(255, 255, 255, 0.32);
    background: rgba(255, 255, 255, 0.09);
  }

  .bg-product-card img,
  .bg-product-card .bg-product-placeholder {
    width: 72px;
    height: 72px;
    object-fit: cover;
    border-radius: 12px;
    background: linear-gradient(135deg, #232326, #101012);
  }

  .bg-product-meta {
    min-width: 0;
  }

  .bg-product-card a {
    color: #fff;
    font-weight: 650;
    text-decoration: none;
    font-size: 14px;
    display: block;
    line-height: 1.35;
  }

  .bg-product-card a:hover {
    color: var(--bg-silver-bright);
  }

  .bg-product-price {
    display: block;
    margin-top: 4px;
    font-size: 14px;
    font-weight: 700;
    color: var(--bg-silver-bright);
  }

  .bg-product-meta small {
    color: var(--bg-muted);
    display: block;
    margin-top: 4px;
    font-size: 12px;
  }

  .bg-stock-pill {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    margin-top: 6px;
    padding: 3px 8px;
    border-radius: 999px;
    font-size: 11px;
    font-weight: 600;
  }

  .bg-stock-pill.in {
    background: var(--success-bg);
    color: var(--success-text);
  }

  .bg-stock-pill.out {
    background: rgba(255, 255, 255, 0.08);
    color: var(--bg-muted);
  }

  .bg-product-cta {
    border: none;
    background: linear-gradient(135deg, #fff, var(--bg-silver));
    color: #0c0c0e;
    border-radius: 999px;
    padding: 8px 14px;
    font-size: 12px;
    font-weight: 700;
    cursor: pointer;
    text-decoration: none;
    white-space: nowrap;
    box-shadow: 0 8px 18px rgba(0, 0, 0, 0.35);
    transition: filter 0.16s ease, transform 0.16s ease;
  }

  .bg-product-cta:hover {
    filter: brightness(1.08);
    transform: translateY(-1px);
  }

  .bg-product-cta:disabled {
    opacity: 0.6;
    cursor: default;
  }

  .bg-product-cta.added {
    background: linear-gradient(135deg, #6fe3a0, #2bd566);
    color: #06210f;
  }

  .bg-product-cta-row {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: 4px;
  }

  .bg-view-cart-link {
    font-size: 11px;
    color: var(--bg-silver-bright);
    text-decoration: none;
    font-weight: 600;
  }

  .bg-view-cart-link:hover {
    text-decoration: underline;
  }

  .bg-category-tiles {
    display: flex;
    gap: 10px;
    overflow-x: auto;
    padding: 2px 2px 12px;
    margin-bottom: 4px;
    scrollbar-width: thin;
  }

  .bg-category-tile {
    flex: 0 0 auto;
    width: 92px;
    border: none;
    background: none;
    cursor: pointer;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 6px;
    font-family: inherit;
    padding: 0;
  }

  .bg-category-tile-image {
    width: 88px;
    height: 88px;
    border-radius: 16px;
    overflow: hidden;
    background: linear-gradient(135deg, #232326, #101012);
    border: 1px solid rgba(255, 255, 255, 0.12);
    transition: border-color 0.15s ease, box-shadow 0.15s ease;
  }

  .bg-category-tile:hover .bg-category-tile-image {
    border-color: var(--bg-silver);
    box-shadow: 0 4px 14px rgba(200, 204, 210, 0.25);
  }

  .bg-category-tile-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .bg-category-tile span {
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.85);
    text-align: center;
    line-height: 1.3;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .bg-shopper-suggestions {
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 9px;
    padding: 0 18px 14px;
  }

  .bg-shopper-suggestions button {
    min-height: 42px;
    border: 1px solid rgba(255, 255, 255, 0.14);
    background: rgba(255, 255, 255, 0.07);
    border-radius: 15px;
    padding: 6px 12px;
    font-size: 12px;
    font-weight: 500;
    color: rgba(255, 255, 255, 0.85);
    cursor: pointer;
    transition: all 0.18s ease;
  }

  .bg-shopper-suggestions button:hover {
    border-color: rgba(255, 255, 255, 0.42);
    background: rgba(255, 255, 255, 0.12);
    color: #fff;
    transform: translateY(-1px);
  }

  .bg-image-preview {
    position: relative;
    z-index: 1;
    display: none;
    padding: 8px 18px 0;
    border-top: 1px solid rgba(255, 255, 255, 0.08);
  }

  .bg-image-preview.visible { display: block; }

  .bg-image-preview-inner {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    background: rgba(255, 255, 255, 0.08);
    border-radius: 10px;
    padding: 6px 8px;
  }

  .bg-image-preview img {
    width: 44px;
    height: 44px;
    object-fit: cover;
    border-radius: 8px;
  }

  .bg-image-preview button {
    border: none;
    background: none;
    color: var(--bg-muted);
    cursor: pointer;
    font-size: 16px;
    line-height: 1;
  }

  .bg-shopper-input {
    position: relative;
    z-index: 1;
    border-top: 1px solid rgba(255, 255, 255, 0.08);
    padding: 14px 18px 18px;
    display: flex;
    gap: 10px;
    align-items: center;
  }

  .bg-shopper-input input[type="text"] {
    flex: 1;
    min-width: 0;
    border: 1px solid rgba(255, 255, 255, 0.11);
    border-radius: 999px;
    padding: 13px 16px;
    font-size: 14px;
    color: #fff;
    background: rgba(255, 255, 255, 0.08);
    outline: none;
    transition: border-color 0.16s ease, background 0.16s ease, box-shadow 0.16s ease;
  }

  .bg-shopper-input input[type="text"]::placeholder {
    color: rgba(255, 255, 255, 0.46);
  }

  .bg-shopper-input input[type="text"]:focus {
    border-color: rgba(255, 255, 255, 0.42);
    background: rgba(255, 255, 255, 0.11);
    box-shadow: 0 0 0 4px rgba(255, 255, 255, 0.08);
  }

  .bg-shopper-input input[type="file"] { display: none; }

  .bg-btn-icon {
    width: 40px;
    height: 40px;
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.08);
    color: rgba(255, 255, 255, 0.85);
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    transition: all 0.15s;
  }

  .bg-btn-icon svg {
    width: 18px;
    height: 18px;
  }

  .bg-btn-icon:hover {
    border-color: rgba(255, 255, 255, 0.4);
    background: rgba(255, 255, 255, 0.14);
  }

  .bg-btn-send {
    width: 46px;
    height: 46px;
    border: none;
    border-radius: 50%;
    background: linear-gradient(135deg, #fff, var(--bg-silver));
    color: #0c0c0e;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    box-shadow: 0 12px 26px rgba(0, 0, 0, 0.35);
    transition: filter 0.16s ease, transform 0.16s ease, opacity 0.16s ease;
  }

  .bg-btn-send:hover:not(:disabled) {
    filter: brightness(1.06);
    transform: translateY(-1px);
  }

  .bg-btn-send svg {
    width: 16px;
    height: 16px;
  }

  .bg-btn-send:disabled { opacity: 0.5; cursor: not-allowed; }

  .bg-icon-btn-plain {
    border: none;
    background: none;
    color: var(--bg-muted);
    cursor: pointer;
    width: 24px;
    height: 24px;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 6px;
  }

  .bg-icon-btn-plain:hover {
    background: rgba(255, 255, 255, 0.1);
    color: #fff;
  }

  .bg-icon-btn-plain svg {
    width: 14px;
    height: 14px;
  }

  .bg-btn-send.loading svg { display: none; }

  .bg-btn-send.loading::after {
    content: "";
    width: 16px;
    height: 16px;
    border: 2px solid rgba(12, 12, 14, 0.35);
    border-top-color: #0c0c0e;
    border-radius: 50%;
    animation: bg-spin 0.7s linear infinite;
  }

  .bg-lead-gate {
    position: relative;
    z-index: 1;
    padding: 16px 18px 12px;
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
    background: rgba(255, 255, 255, 0.04);
    display: none;
  }

  .bg-lead-gate.visible {
    display: block;
  }

  .bg-lead-gate h3 {
    margin: 0 0 4px;
    font-size: 14px;
    color: #fff;
  }

  .bg-lead-gate p {
    margin: 0 0 12px;
    font-size: 12px;
    color: var(--bg-muted);
    line-height: 1.4;
  }

  .bg-lead-gate label {
    display: block;
    font-size: 12px;
    font-weight: 600;
    color: rgba(255, 255, 255, 0.75);
    margin-bottom: 4px;
  }

  .bg-lead-gate input {
    width: 100%;
    box-sizing: border-box;
    border: 1px solid rgba(255, 255, 255, 0.14);
    border-radius: 10px;
    padding: 10px 12px;
    font-size: 14px;
    margin-bottom: 10px;
    outline: none;
    color: #fff;
    background: rgba(255, 255, 255, 0.06);
  }

  .bg-lead-gate input::placeholder {
    color: rgba(255, 255, 255, 0.4);
  }

  .bg-lead-gate input:focus {
    border-color: rgba(255, 255, 255, 0.4);
    box-shadow: 0 0 0 3px rgba(255, 255, 255, 0.1);
  }

  .bg-lead-error {
    display: none;
    font-size: 12px;
    color: #ff8a8a;
    margin: -4px 0 10px;
  }

  .bg-lead-error.visible {
    display: block;
  }

  .bg-lead-submit {
    width: 100%;
    border: none;
    border-radius: 999px;
    background: linear-gradient(135deg, #fff, var(--bg-silver));
    color: #0c0c0e;
    font-weight: 700;
    font-size: 14px;
    padding: 11px 14px;
    cursor: pointer;
  }

  .bg-lead-submit:disabled {
    opacity: 0.6;
    cursor: not-allowed;
  }

  .bg-quiz-card {
    margin: 4px 12px 12px;
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 18px;
    background: rgba(255, 255, 255, 0.06);
    overflow: hidden;
    animation: bg-msg-in 0.25s ease-out;
  }

  .bg-quiz-card-header {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 8px;
    padding: 14px 14px 6px;
  }

  .bg-quiz-card-header strong {
    font-size: 15px;
    color: #fff;
    line-height: 1.35;
  }

  .bg-quiz-card-header span {
    display: block;
    margin-top: 4px;
    font-size: 12px;
    font-weight: 500;
    color: var(--bg-muted);
  }

  .bg-quiz-close {
    border: none;
    background: transparent;
    color: var(--bg-muted);
    cursor: pointer;
    font-size: 18px;
    line-height: 1;
    padding: 2px 6px;
  }

  .bg-quiz-options {
    display: flex;
    flex-direction: column;
    gap: 6px;
    padding: 8px 10px 12px;
  }

  .bg-quiz-option {
    display: flex;
    align-items: center;
    gap: 12px;
    width: 100%;
    border: 1px solid rgba(255, 255, 255, 0.1);
    background: rgba(255, 255, 255, 0.05);
    text-align: left;
    padding: 12px 12px;
    border-radius: 14px;
    cursor: pointer;
    font-size: 14px;
    font-weight: 500;
    color: rgba(255, 255, 255, 0.85);
    transition: all 0.15s ease;
  }

  .bg-quiz-option:hover {
    background: rgba(255, 255, 255, 0.1);
    border-color: rgba(255, 255, 255, 0.32);
    color: #fff;
  }

  .bg-quiz-option-icon {
    width: 28px;
    height: 28px;
    border-radius: 8px;
    background: linear-gradient(150deg, #1c1c1f, var(--bg-black));
    border: 1px solid rgba(255, 255, 255, 0.16);
    color: var(--bg-silver-bright);
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    font-size: 13px;
  }

  .bg-quiz-footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 10px 12px 12px;
    border-top: 1px solid rgba(255, 255, 255, 0.08);
  }

  .bg-quiz-dots {
    display: flex;
    gap: 6px;
    align-items: center;
  }

  .bg-quiz-dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.24);
  }

  .bg-quiz-dot.active {
    background: var(--bg-silver-bright);
  }

  .bg-quiz-nav {
    width: 34px;
    height: 34px;
    border-radius: 50%;
    border: none;
    background: linear-gradient(135deg, #fff, var(--bg-silver));
    color: #0c0c0e;
    cursor: pointer;
    display: inline-flex;
    align-items: center;
    justify-content: center;
  }

  .bg-quiz-nav:disabled {
    background: rgba(255, 255, 255, 0.1);
    color: rgba(255, 255, 255, 0.4);
    cursor: not-allowed;
  }

  @media (prefers-reduced-motion: reduce) {
    .bg-shopper-launcher,
    .bg-shopper-launcher:after,
    .bg-typing span {
      animation: none;
    }
  }

  @media (max-width: 520px) {
    .bg-shopper-launcher-wrap {
      right: 16px;
      bottom: 16px;
    }
    .bg-shopper-panel {
      right: 16px;
      bottom: 92px;
      height: min(640px, calc(100svh - 108px));
      border-radius: 22px;
    }
    .bg-shopper-header {
      padding: 16px;
    }
    .bg-shopper-header strong {
      font-size: 16px;
    }
    .bg-shopper-suggestions {
      grid-template-columns: 1fr;
    }
    .bg-shopper-launcher {
      width: 58px;
      height: 58px;
      border-radius: 20px;
    }
  }
</style>

<script>
  (() => {
    const root = document.getElementById("bundleguard-shopper-root");
    if (!root || root.dataset.initialized === "true") return;
    root.dataset.initialized = "true";

    const proxyUrl = root.dataset.proxyUrl || "/apps/bundleguard/chat";
    let suggestions = [
      "Help me choose ✨",
      "What's in stock?",
    ];

    root.innerHTML = `
      <div class="bg-shopper-launcher-wrap">
        <button class="bg-shopper-launcher" aria-label="Open shopping assistant" aria-expanded="false">
          <span class="bg-shopper-launcher-icons">
            <svg class="bg-launcher-icon--chat" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M7.9 20A9 9 0 1 0 4 16.1L2 22Z"></path>
            </svg>
            <svg class="bg-launcher-icon--close" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <line x1="18" y1="6" x2="6" y2="18"></line>
              <line x1="6" y1="6" x2="18" y2="18"></line>
            </svg>
          </span>
        </button>
      </div>
      <section class="bg-shopper-panel" aria-label="BundleGuard shopper assistant">
        <div class="bg-shopper-header">
          <div class="bg-shopper-header-main">
            <div class="bg-shopper-logo" aria-hidden="true">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path>
                <path d="m9 12 2 2 4-4"></path>
              </svg>
            </div>
            <div>
              <p class="bg-shopper-eyebrow">Shopping Assistant</p>
              <strong>BundleGuard AI</strong>
              <span class="bg-shopper-status"><i aria-hidden="true"></i>Online now</span>
            </div>
          </div>
          <button type="button" class="bg-shopper-close" aria-label="Close chat">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <line x1="18" y1="6" x2="6" y2="18"></line>
              <line x1="6" y1="6" x2="18" y2="18"></line>
            </svg>
          </button>
        </div>
        <div class="bg-lead-gate" id="bg-lead-gate">
          <h3>Before we start</h3>
          <p>Share your name and email so we can help you.</p>
          <form class="bg-lead-form">
            <label for="bg-lead-name">Full name</label>
            <input id="bg-lead-name" name="name" type="text" autocomplete="name" placeholder="Jane Doe" required />
            <label for="bg-lead-email">Email</label>
            <input id="bg-lead-email" name="email" type="email" autocomplete="email" placeholder="jane@email.com" required />
            <div class="bg-lead-error" role="alert"></div>
            <button type="submit" class="bg-lead-submit">Continue to chat</button>
          </form>
        </div>
        <div class="bg-shopper-messages">
          <div class="bg-msg assistant">Hi! I can help you find products and check what's in stock. Upload a product photo to find the same item or close alternatives.</div>
          <div class="bg-category-tiles" style="display:none;"></div>
        </div>
        <div class="bg-shopper-suggestions">
          <button type="button" data-suggestion="Help me choose ✨">Help me choose ✨</button>
          <button type="button" data-suggestion="What's in stock?">What's in stock?</button>
        </div>
        <div class="bg-image-preview">
          <div class="bg-image-preview-inner">
            <img alt="Upload preview" />
            <span style="font-size:12px;color:#6d7175;">Product photo attached</span>
            <button type="button" class="bg-icon-btn-plain bg-remove-image" aria-label="Remove image">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <line x1="18" y1="6" x2="6" y2="18"></line>
                <line x1="6" y1="6" x2="18" y2="18"></line>
              </svg>
            </button>
          </div>
        </div>
        <form class="bg-shopper-input">
          <input type="file" accept="image/jpeg,image/png,image/webp,image/gif" class="bg-file-input" />
          <button type="button" class="bg-btn-icon bg-upload-btn" aria-label="Upload product image">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <rect x="3" y="3" width="18" height="18" rx="2"></rect>
              <circle cx="8.5" cy="8.5" r="1.5"></circle>
              <path d="m21 15-5-5L5 21"></path>
            </svg>
          </button>
          <input type="text" placeholder="Ask about products..." autocomplete="off" />
          <button type="submit" class="bg-btn-send" aria-label="Send message">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <line x1="22" y1="2" x2="11" y2="13"></line>
              <polygon points="22 2 15 22 11 13 2 9 22 2"></polygon>
            </svg>
          </button>
        </form>
      </section>
    `;

    const launcherWrap = root.querySelector(".bg-shopper-launcher-wrap");
    const launcher = root.querySelector(".bg-shopper-launcher");
    const panel = root.querySelector(".bg-shopper-panel");
    const closeBtn = root.querySelector(".bg-shopper-close");
    const messagesEl = root.querySelector(".bg-shopper-messages");
    const suggestionsEl = root.querySelector(".bg-shopper-suggestions");
    const form = root.querySelector(".bg-shopper-input");
    const input = form.querySelector('input[type="text"]');
    const fileInput = form.querySelector(".bg-file-input");
    const uploadBtn = form.querySelector(".bg-upload-btn");
    const sendBtn = form.querySelector(".bg-btn-send");
    const imagePreview = root.querySelector(".bg-image-preview");
    const previewImg = imagePreview.querySelector("img");
    const removeImageBtn = root.querySelector(".bg-remove-image");
    const leadGate = root.querySelector("#bg-lead-gate");
    const leadForm = root.querySelector(".bg-lead-form");
    const leadError = root.querySelector(".bg-lead-error");
    const leadSubmit = root.querySelector(".bg-lead-submit");
    const categoryTilesEl = root.querySelector(".bg-category-tiles");

    let enabled = true;
    let thinking = false;
    let pendingImage = null;
    let settingsLoaded = false;
    let quizState = { category: null, budget: null };
    // Runs automatically once the lead form is submitted successfully —
    // browsing (category tiles) never needs this; only a real question does.
    let pendingAction = null;
    let leadId = null;
    try {
      leadId = localStorage.getItem("bg_shopper_lead_id");
    } catch (_) {
      leadId = null;
    }

    function showLeadGate() {
      leadGate.classList.add("visible");
      leadGate.scrollIntoView({ behavior: "smooth", block: "nearest" });
    }

    function hideLeadGate() {
      leadGate.classList.remove("visible");
    }

    /** Browsing is always free; only a real question/AI answer needs a lead. */
    function requireLeadThen(action) {
      if (leadId) {
        action();
        return;
      }
      pendingAction = action;
      showLeadGate();
    }

    suggestionsEl.querySelectorAll("[data-suggestion]").forEach((btn) => {
      btn.addEventListener("click", () => {
        const text = btn.getAttribute("data-suggestion");
        requireLeadThen(() => sendMessage(text));
      });
    });

    leadForm.addEventListener("submit", async (event) => {
      event.preventDefault();
      leadError.classList.remove("visible");
      const name = String(leadForm.name.value || "").trim();
      const email = String(leadForm.email.value || "").trim();
      if (!name || !email) {
        leadError.textContent = "Name and email are required.";
        leadError.classList.add("visible");
        return;
      }

      leadSubmit.disabled = true;
      leadSubmit.textContent = "Saving...";

      try {
        const res = await fetch(proxyUrl, {
          method: "POST",
          headers: { "Content-Type": "application/json", Accept: "application/json" },
          body: JSON.stringify({
            intent: "lead",
            name,
            email,
            sessionKey: leadId || undefined,
          }),
        });
        const data = await res.json().catch(() => ({}));
        if (!res.ok || !data.leadId) {
          leadError.textContent = data.error || "Could not save your details.";
          leadError.classList.add("visible");
          return;
        }
        leadId = data.leadId;
        try {
          localStorage.setItem("bg_shopper_lead_id", leadId);
          localStorage.setItem("bg_shopper_lead_name", data.name || name);
          localStorage.setItem("bg_shopper_lead_email", data.email || email);
          localStorage.removeItem("bg_shopper_has_profile");
          localStorage.removeItem("bg_shopper_profile_preview");
        } catch (_) {}
        hideLeadGate();
        addMessage(
          "assistant",
          data.message || `Thanks ${name}! Ask me anything about our products.`,
        );
        if (pendingAction) {
          const action = pendingAction;
          pendingAction = null;
          action();
        }
      } catch (_) {
        leadError.textContent = "Connection issue. Please try again.";
        leadError.classList.add("visible");
      } finally {
        leadSubmit.disabled = false;
        leadSubmit.textContent = "Continue to chat";
      }
    });

    function scrollToBottom() {
      messagesEl.scrollTop = messagesEl.scrollHeight;
    }

    function setLoading(isLoading) {
      thinking = isLoading;
      sendBtn.disabled = isLoading;
      sendBtn.classList.toggle("loading", isLoading);
      input.disabled = isLoading;
      uploadBtn.disabled = isLoading;
    }

    function cleanText(text) {
      return String(text || "")
        .replace(/\*\*([^*]+)\*\*/g, "$1")
        .replace(/\*([^*]+)\*/g, "$1")
        .replace(/__([^_]+)__/g, "$1")
        .replace(/`([^`]+)`/g, "$1")
        .replace(/[—–•●◆◇★☆]/g, (ch) => (ch === "—" || ch === "–" ? "-" : ""))
        .replace(/[ \t]+\n/g, "\n")
        .replace(/\n{3,}/g, "\n\n")
        .trim();
    }

    function addMessage(role, text, imageSrc) {
      const bubble = document.createElement("div");
      bubble.className = `bg-msg ${role}`;
      if (text) bubble.appendChild(document.createTextNode(cleanText(text)));
      if (imageSrc) {
        const img = document.createElement("img");
        img.src = imageSrc;
        img.alt = "Uploaded product";
        bubble.appendChild(img);
      }
      messagesEl.appendChild(bubble);
      scrollToBottom();
    }

    function showTyping() {
      const bubble = document.createElement("div");
      bubble.className = "bg-msg assistant bg-typing-wrap";
      bubble.innerHTML = '<div class="bg-typing"><span></span><span></span><span></span></div>';
      messagesEl.appendChild(bubble);
      scrollToBottom();
      return bubble;
    }

    function renderSuggestions(items) {
      suggestionsEl.innerHTML = "";
      items.forEach((text) => {
        const btn = document.createElement("button");
        btn.type = "button";
        btn.textContent = text;
        btn.addEventListener("click", () => {
          requireLeadThen(() => sendMessage(text));
        });
        suggestionsEl.appendChild(btn);
      });
    }

    function renderRecommendations(items) {
      if (!items || !items.length) return;
      const wrap = document.createElement("div");
      wrap.className = "bg-reco-list";

      items.slice(0, 3).forEach((item) => {
        const card = document.createElement("div");
        card.className = "bg-product-card";

        if (item.imageUrl) {
          const img = document.createElement("img");
          try {
            const u = new URL(String(item.imageUrl), window.location.origin);
            if (u.protocol === "http:" || u.protocol === "https:") img.src = u.href;
          } catch (_) {}
          img.alt = String(item.title || "Product");
          card.appendChild(img);
        } else {
          const ph = document.createElement("div");
          ph.className = "bg-product-placeholder";
          card.appendChild(ph);
        }

        const meta = document.createElement("div");
        meta.className = "bg-product-meta";
        const link = document.createElement("a");
        let href = "#";
        try {
          const u = new URL(String(item.url || ""), window.location.origin);
          href =
            u.protocol === "http:" || u.protocol === "https:" ? u.href : "#";
        } catch (_) {}
        link.href = href;
        link.target = "_blank";
        link.rel = "noopener";
        link.textContent = cleanText(item.title || "Product");

        const price = document.createElement("span");
        price.className = "bg-product-price";
        price.textContent = "$" + String(item.price || "");

        const pill = document.createElement("span");
        pill.className =
          "bg-stock-pill " + (item.available ? "in" : "out");
        pill.textContent = item.available ? "In stock" : "Limited";

        const reason = document.createElement("small");
        reason.textContent = cleanText(item.reason || "Recommended for you");

        meta.appendChild(link);
        meta.appendChild(price);
        meta.appendChild(pill);
        meta.appendChild(reason);
        card.appendChild(meta);

        const ctaWrap = document.createElement("div");
        ctaWrap.className = "bg-product-cta-row";

        if (item.variantId) {
          const addBtn = document.createElement("button");
          addBtn.type = "button";
          addBtn.className = "bg-product-cta";
          addBtn.textContent = "+ Add to cart";
          addBtn.addEventListener("click", () => addToCart(item.variantId, addBtn, ctaWrap));
          ctaWrap.appendChild(addBtn);
        } else {
          const cta = document.createElement("a");
          cta.className = "bg-product-cta";
          cta.href = href;
          cta.target = "_blank";
          cta.rel = "noopener";
          cta.textContent = "View";
          ctaWrap.appendChild(cta);
        }
        card.appendChild(ctaWrap);

        wrap.appendChild(card);
      });

      messagesEl.appendChild(wrap);
      scrollToBottom();
    }

    /** Real Shopify Storefront Cart AJAX API — same-origin, no backend involved. */
    async function addToCart(variantId, button, container) {
      if (button.disabled) return;
      button.disabled = true;
      const original = button.textContent;
      button.textContent = "Adding...";
      try {
        const res = await fetch("/cart/add.js", {
          method: "POST",
          headers: { "Content-Type": "application/json", Accept: "application/json" },
          body: JSON.stringify({ items: [{ id: Number(variantId), quantity: 1 }] }),
        });
        if (res.ok) {
          button.textContent = "Added ✓";
          button.classList.add("added");
          try {
            document.dispatchEvent(new CustomEvent("cart:refresh"));
          } catch (_) {}
          if (container && !container.querySelector(".bg-view-cart-link")) {
            const viewCart = document.createElement("a");
            viewCart.className = "bg-view-cart-link";
            viewCart.href = "/cart";
            viewCart.textContent = "View cart →";
            container.appendChild(viewCart);
          }
          setTimeout(() => {
            button.disabled = false;
            button.textContent = original;
            button.classList.remove("added");
          }, 2500);
        } else {
          button.textContent = "Try again";
          button.disabled = false;
        }
      } catch (_) {
        button.textContent = "Try again";
        button.disabled = false;
      }
    }

    function renderCategoryTiles(tiles) {
      if (!tiles || !tiles.length) {
        categoryTilesEl.style.display = "none";
        return;
      }
      categoryTilesEl.innerHTML = "";
      tiles.forEach((tile) => {
        const btn = document.createElement("button");
        btn.type = "button";
        btn.className = "bg-category-tile";

        const imageWrap = document.createElement("div");
        imageWrap.className = "bg-category-tile-image";
        if (tile.imageUrl) {
          const img = document.createElement("img");
          try {
            const u = new URL(String(tile.imageUrl), window.location.origin);
            if (u.protocol === "http:" || u.protocol === "https:") img.src = u.href;
          } catch (_) {}
          img.alt = String(tile.label || "Category");
          imageWrap.appendChild(img);
        }

        const label = document.createElement("span");
        label.textContent = cleanText(tile.label || tile.value || "");

        btn.appendChild(imageWrap);
        btn.appendChild(label);
        btn.addEventListener("click", () => browseCategory(tile.value, tile.label));
        categoryTilesEl.appendChild(btn);
      });
      categoryTilesEl.style.display = "flex";
    }

    /** Category tap = free browsing, deterministic results, no lead/AI needed. */
    async function browseCategory(value, label) {
      if (thinking || !enabled || !value) return;
      addMessage("user", label || value);
      clearQuizCards();
      setLoading(true);
      const typing = showTyping();

      try {
        const res = await fetch(proxyUrl, {
          method: "POST",
          headers: { "Content-Type": "application/json", Accept: "application/json" },
          body: JSON.stringify({ intent: "browse-category", category: value }),
        });
        const raw = await res.text();
        let data = {};
        try {
          data = raw ? JSON.parse(raw) : {};
        } catch (_) {
          data = {};
        }
        typing.remove();

        if (data.ok && Array.isArray(data.recommendations) && data.recommendations.length) {
          addMessage("assistant", `Here's a curated selection from ${label || value}:`);
          renderRecommendations(data.recommendations);
        } else {
          addMessage(
            "assistant",
            data.message || "Couldn't find products in that category right now.",
          );
        }
      } catch (_) {
        typing.remove();
        addMessage("assistant", "Connection issue. Please try again.");
      } finally {
        setLoading(false);
      }
    }

    function clearQuizCards() {
      root.querySelectorAll(".bg-quiz-card").forEach((el) => el.remove());
    }

    function renderQuizCard(quiz) {
      if (!quiz || !quiz.options || !quiz.options.length) return;
      clearQuizCards();

      const card = document.createElement("div");
      card.className = "bg-quiz-card";

      const header = document.createElement("div");
      header.className = "bg-quiz-card-header";
      const titleWrap = document.createElement("div");
      const title = document.createElement("strong");
      title.textContent = cleanText(quiz.title || "Choose an option");
      const subtitle = document.createElement("span");
      subtitle.textContent =
        quiz.step === "category"
          ? "Based on categories in this store"
          : "Based on real prices in your selection";
      titleWrap.appendChild(title);
      titleWrap.appendChild(subtitle);
      const close = document.createElement("button");
      close.type = "button";
      close.className = "bg-quiz-close";
      close.setAttribute("aria-label", "Close");
      close.textContent = "×";
      close.addEventListener("click", () => card.remove());
      header.appendChild(titleWrap);
      header.appendChild(close);

      const optionsEl = document.createElement("div");
      optionsEl.className = "bg-quiz-options";

      quiz.options.forEach((opt) => {
        const btn = document.createElement("button");
        btn.type = "button";
        btn.className = "bg-quiz-option";
        const icon = document.createElement("span");
        icon.className = "bg-quiz-option-icon";
        icon.setAttribute("aria-hidden", "true");
        icon.textContent = quiz.step === "budget" ? "$" : "✓";
        const label = document.createElement("span");
        label.textContent = cleanText(opt.label || opt.value);
        btn.appendChild(icon);
        btn.appendChild(label);
        btn.addEventListener("click", () => {
          if (!leadId || thinking) return;
          if (quiz.step === "category") {
            quizState.category = opt.value;
            quizState.budget = null;
            addMessage("user", opt.label || opt.value);
            sendQuizStep("budget", opt.value, null, opt.label || opt.value);
          } else if (quiz.step === "budget") {
            quizState.budget = opt.value;
            addMessage("user", opt.label || opt.value);
            sendQuizStep(
              "results",
              quizState.category,
              opt.value,
              opt.label || opt.value,
            );
          }
        });
        optionsEl.appendChild(btn);
      });

      const footer = document.createElement("div");
      footer.className = "bg-quiz-footer";
      const back = document.createElement("button");
      back.type = "button";
      back.className = "bg-quiz-nav";
      back.textContent = "←";
      back.disabled = quiz.step === "category";
      back.addEventListener("click", () => {
        if (quiz.step === "budget") {
          quizState.budget = null;
          sendQuizStep("category", null, null, "Change category");
        }
      });
      const dots = document.createElement("div");
      dots.className = "bg-quiz-dots";
      const total = Number(quiz.totalPages || 2);
      for (let i = 1; i <= total; i++) {
        const dot = document.createElement("span");
        dot.className =
          "bg-quiz-dot" + (i === Number(quiz.page || 1) ? " active" : "");
        dots.appendChild(dot);
      }
      const next = document.createElement("button");
      next.type = "button";
      next.className = "bg-quiz-nav";
      next.textContent = "→";
      next.disabled = true;

      footer.appendChild(back);
      footer.appendChild(dots);
      footer.appendChild(next);

      card.appendChild(header);
      card.appendChild(optionsEl);
      card.appendChild(footer);
      panel.insertBefore(card, suggestionsEl);
      scrollToBottom();
    }

    async function sendQuizStep(step, category, budget, displayText) {
      if (thinking || !enabled || !leadId) return;
      clearQuizCards();
      suggestionsEl.innerHTML = "";
      setLoading(true);
      const typing = showTyping();
      let data = {};

      try {
        const res = await fetch(proxyUrl, {
          method: "POST",
          headers: { "Content-Type": "application/json", Accept: "application/json" },
          body: JSON.stringify({
            question: displayText || "recommend",
            leadId,
            quizStep: step,
            selectedCategory: category,
            selectedBudget: budget,
          }),
        });
        const raw = await res.text();
        try {
          data = raw ? JSON.parse(raw) : {};
        } catch {
          data = {};
        }
        typing.remove();

        if (data.requireLead) {
          leadId = null;
          try {
            localStorage.removeItem("bg_shopper_lead_id");
          } catch (_) {}
          pendingAction = () => sendQuizStep(step, category, budget, displayText);
          showLeadGate();
          return;
        }

        if (data.answer) addMessage("assistant", data.answer);
        if (data.quiz) renderQuizCard(data.quiz);
        else renderRecommendations(data.recommendations || []);
        if (Array.isArray(data.suggestions) && data.suggestions.length) {
          suggestions = data.suggestions;
        }
      } catch (_) {
        typing.remove();
        addMessage("assistant", "Connection issue. Please try again.");
      } finally {
        setLoading(false);
        if (!data.quiz) {
          renderSuggestions(suggestions);
        }
      }
    }

    function clearPendingImage() {
      pendingImage = null;
      fileInput.value = "";
      imagePreview.classList.remove("visible");
      previewImg.removeAttribute("src");
    }

    function setPendingImage(dataUrl) {
      pendingImage = dataUrl;
      previewImg.src = dataUrl;
      imagePreview.classList.add("visible");
    }

    async function loadSettings() {
      if (settingsLoaded) return;
      settingsLoaded = true;

      try {
        const res = await fetch(proxyUrl, { method: "GET", headers: { Accept: "application/json" } });
        const data = await res.json();
        enabled = Boolean(data.enabled);
        root.style.display = enabled ? "" : "none";
        if (!enabled) panel.classList.remove("open");
        const welcome =
          data.welcomeMessage ||
          "Hi! I can help you find products and check what's in stock. Upload a product photo to find the same item or close alternatives.";
        const firstMsg = messagesEl.querySelector(".bg-msg.assistant");
        if (firstMsg) {
          firstMsg.textContent = cleanText(welcome);
        }
        if (Array.isArray(data.suggestions) && data.suggestions.length) {
          suggestions = data.suggestions;
          renderSuggestions(suggestions);
        }
        if (Array.isArray(data.categoryTiles) && data.categoryTiles.length) {
          renderCategoryTiles(data.categoryTiles);
        }
      } catch {
        enabled = false;
        root.style.display = "none";
      }
    }

    async function sendMessage(text) {
      const question = String(text || "").trim();
      if ((!question && !pendingImage) || thinking || !enabled) return;

      if (!leadId) {
        pendingAction = () => sendMessage(text);
        showLeadGate();
        return;
      }

      const imageToSend = pendingImage;
      addMessage("user", question || "Find products like this", imageToSend);
      input.value = "";
      clearPendingImage();
      clearQuizCards();
      suggestionsEl.innerHTML = "";
      setLoading(true);

      const typing = showTyping();
      let data = {};

      try {
        const res = await fetch(proxyUrl, {
          method: "POST",
          headers: { "Content-Type": "application/json", Accept: "application/json" },
          body: JSON.stringify({ question, image: imageToSend, leadId }),
        });
        const raw = await res.text();
        try {
          data = raw ? JSON.parse(raw) : {};
        } catch {
          data = {};
        }
        typing.remove();

        if (data.requireLead) {
          leadId = null;
          try {
            localStorage.removeItem("bg_shopper_lead_id");
          } catch (_) {}
          pendingAction = () => sendMessage(question);
          showLeadGate();
          return;
        }

        if (data.answer) {
          addMessage("assistant", data.answer);
          if (data.quiz) renderQuizCard(data.quiz);
          else renderRecommendations(data.recommendations || []);
        } else if (data.error) {
          addMessage("assistant", data.error);
        } else {
          addMessage(
            "assistant",
            "I couldn't load product results right now. Please try again.",
          );
        }
      } catch {
        typing.remove();
        addMessage(
          "assistant",
          "Connection issue. Please refresh the page and try again.",
        );
      } finally {
        setLoading(false);
        if (!data?.quiz) {
          renderSuggestions(
            Array.isArray(data?.suggestions) && data.suggestions.length
              ? data.suggestions
              : suggestions,
          );
        }
      }
    }

    uploadBtn.addEventListener("click", () => fileInput.click());

    fileInput.addEventListener("change", () => {
      const file = fileInput.files && fileInput.files[0];
      if (!file) return;
      if (file.size > 5 * 1024 * 1024) {
        addMessage("assistant", "Please upload an image under 5 MB.");
        fileInput.value = "";
        return;
      }
      const reader = new FileReader();
      reader.onload = () => setPendingImage(String(reader.result));
      reader.readAsDataURL(file);
    });

    removeImageBtn.addEventListener("click", clearPendingImage);

    function setPanelOpen(isOpen) {
      panel.classList.toggle("open", isOpen);
      launcherWrap.classList.toggle("is-open", isOpen);
      launcher.setAttribute("aria-expanded", String(isOpen));
      launcher.setAttribute(
        "aria-label",
        isOpen ? "Close shopping assistant" : "Open shopping assistant",
      );
    }

    function togglePanel() {
      const willOpen = !panel.classList.contains("open");
      setPanelOpen(willOpen);
      if (willOpen) loadSettings();
    }

    launcher.addEventListener("click", togglePanel);

    closeBtn.addEventListener("click", () => setPanelOpen(false));

    form.addEventListener("submit", (event) => {
      event.preventDefault();
      sendMessage(input.value);
    });

    // Fail-closed: hide widget until settings confirm enabled
    root.style.display = "none";
    loadSettings();
  })();
</script>

{% schema %}
{
  "name": "Shopper Assistant",
  "target": "body",
  "settings": [
    {
      "type": "paragraph",
      "content": "Shows a floating AI shopping assistant on your storefront. Customers can ask for products, upload photos, and get recommendations."
    }
  ]
}
{% endschema %}

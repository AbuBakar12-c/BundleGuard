# BundleGuard production secrets for Render - names only.
# Paste into Render -> bundleguard service -> Environment (Blueprint sync:false fields).

NODE_ENV=production
SHOPIFY_BILLING_TEST=false

SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=
SCOPES=read_products,write_products,read_inventory,read_locations,read_orders,write_app_proxy

# Exact public HTTPS URL from Render (no trailing slash)
SHOPIFY_APP_URL=https://bundleguard.onrender.com

# Linked automatically from Render Postgres when using render.yaml
DATABASE_URL=

OPENAI_API_KEY=

SUPPORT_EMAIL=
PRIVACY_EMAIL=
COMPANY_NAME=
PRIVACY_POLICY_URL=

# =============================================================================
# BundleGuard environment template — NAMES ONLY, never real secrets.
# Copy to .env for local development. Production: set via host secrets (Fly/etc).
# =============================================================================

# Partner Dashboard → App → Client credentials (must match shopify.app.toml client_id)
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=

# Must match [access_scopes] in shopify.app.toml
SCOPES=read_products,write_products,read_inventory,read_locations,read_orders,write_app_proxy

# Local/dev: tunnel URL is rewritten by `shopify app dev`
# Production: MUST be your real HTTPS host (never example.com / localhost / tunnel)
# Example production: https://bundleguard.fly.dev  (replace with your actual host)
SHOPIFY_APP_URL=

# Local: file:dev.sqlite
# Production: postgresql://USER:PASSWORD@HOST:5432/DB?sslmode=require
DATABASE_URL=file:dev.sqlite

# true  = local/dev: billing not enforced, Pro features unlocked for testing
# false = production: Shopify Billing required (Dockerfile / fly.toml default false)
SHOPIFY_BILLING_TEST=true

# Optional but required for full AI quality
OPENAI_API_KEY=

# Privacy / App Store contact (set before submission — used by /privacy)
SUPPORT_EMAIL=
PRIVACY_EMAIL=
COMPANY_NAME=
PRIVACY_POLICY_URL=
# TERMS_URL=

# Optional: outbound webhook when a bundle becomes blocked (Growth+ only)
# MERCHANT_ALERT_WEBHOOK_URL=

# Optional: ops alert (Slack/Zapier/etc.) when a webhook handler fails
# internally after already returning 200 to Shopify (uninstall purge, GDPR
# redact/export, order/inventory sync). Payload is shop + topic + timestamp
# only — never error detail or customer data. See app/services/http.server.ts.
# OPS_ALERT_WEBHOOK_URL=

# Optional custom shop domain allowlist
# SHOP_CUSTOM_DOMAIN=

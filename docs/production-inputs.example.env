# Production inputs checklist (BundleGuard -> Render)
#
# Copy this file to `production.inputs.env` (gitignored) and fill real values.
# Do NOT commit secrets. Apply with:
#   powershell -ExecutionPolicy Bypass -File .\scripts\apply-production-inputs.ps1
#
# Required before go-live:

# Your Render public HTTPS URL (after first deploy), e.g. https://bundleguard.onrender.com
PRODUCTION_APP_URL=

# Privacy / App Store
SUPPORT_EMAIL=
PRIVACY_EMAIL=
COMPANY_NAME=
# Optional public privacy URL (can be https://YOUR_APP/privacy)
PRIVACY_POLICY_URL=

# Partner-owned Shopify app? must be true for live Billing
PARTNER_OWNED_APP=true

# Rotate Shopify API secret + OpenAI key after wiring production? recommended true
ROTATE_SECRETS_ACK=true

# Shopify credentials (same as Partner Dashboard / local .env — set on Railway, not only here)
# SHOPIFY_API_KEY=
# SHOPIFY_API_SECRET=
# OPENAI_API_KEY=
